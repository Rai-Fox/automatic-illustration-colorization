TELEGRAM_BOT_TOKEN=your-telegram-token
COLORIZATION_API_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
BOT_DATABASE_URL=postgresql://colorizer:colorizer@postgres:5432/colorizer
BOT_MAX_REFERENCE_BYTES=10485760
BOT_MAX_REFERENCE_SIDE=4096

# Supported by run_docker scripts:
# passthrough, cgan/cgan_reference, colorcomic_auto, ddcolor, deoldify.
# cgan is normalized to the API model_id cgan_reference.
COLORIZATION_MODEL_ID=ddcolor
COLORIZATION_DEVICE=cpu
ENABLED_MODELS=cgan_reference,colorcomic_auto,ddcolor,deoldify

# The run_docker scripts derive this automatically. Set it for direct docker compose usage.
# Keep API light by default; heavy model dependencies belong to worker.
API_EXTRA_UV_GROUPS=
WORKER_EXTRA_UV_GROUPS=--group model-cgan --group model-colorcomic --group model-ddcolor --group model-deoldify
