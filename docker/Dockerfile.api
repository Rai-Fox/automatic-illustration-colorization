# syntax=docker/dockerfile:1.7
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy \
    PIP_NO_CACHE_DIR=1

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY illustration_colorizer ./illustration_colorizer
COPY services ./services
COPY shared ./shared

ARG EXTRA_UV_GROUPS=""
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --group api ${EXTRA_UV_GROUPS}

EXPOSE 8000

CMD ["sh", "-c", "uv run --frozen --no-dev --group api ${EXTRA_UV_GROUPS:-} python -m services.api.app.run"]
