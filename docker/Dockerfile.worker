FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

COPY pyproject.toml uv.lock README.md ./
COPY illustration_colorizer ./illustration_colorizer
COPY services ./services
COPY shared ./shared

ARG EXTRA_UV_GROUPS=""
RUN uv sync --frozen --no-dev --group api --group worker ${EXTRA_UV_GROUPS}

CMD ["sh", "-c", "uv run --frozen --no-dev --group api --group worker ${EXTRA_UV_GROUPS:-} python -m services.worker.run"]
